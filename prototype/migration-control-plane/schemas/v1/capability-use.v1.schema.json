{
  "$id": "urn:orca:migration-control-plane:capability-use.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignmentId": {
      "maxLength": 128,
      "minLength": 12,
      "pattern": "^assignment_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "attemptId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^attempt_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "capabilityId": {
      "maxLength": 128,
      "minLength": 12,
      "pattern": "^capability_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "capabilityVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "evaluationResultIds": {
      "items": {
        "maxLength": 128,
        "minLength": 19,
        "pattern": "^evaluation_result_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "id": {
      "maxLength": 128,
      "minLength": 16,
      "pattern": "^capability_use_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "inputDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "kind": {
      "const": "capability-use",
      "type": "string"
    },
    "missionId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^mission_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "modelRoute": {
      "additionalProperties": false,
      "properties": {
        "dataClasses": {
          "items": {
            "enum": ["synthetic", "public", "internal", "confidential", "restricted", "phi"],
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array"
        },
        "effort": {
          "enum": ["lo", "med", "hi"],
          "type": "string"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["provider", "model", "revision", "effort", "dataClasses"],
      "type": "object"
    },
    "outcome": {
      "enum": ["helped", "neutral", "harmed", "unknown"],
      "type": "string"
    },
    "outputDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "usage": {
      "additionalProperties": false,
      "properties": {
        "cacheReadTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "cacheWriteTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "costUsd": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "number"
        },
        "inputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "outputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "toolCalls": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "wallTimeMs": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "cacheReadTokens",
        "cacheWriteTokens",
        "toolCalls",
        "wallTimeMs",
        "costUsd"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "missionId",
    "createdAt",
    "capabilityId",
    "capabilityVersion",
    "assignmentId",
    "attemptId",
    "modelRoute",
    "inputDigest",
    "outputDigest",
    "evaluationResultIds",
    "outcome",
    "usage"
  ],
  "title": "capability-use.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "capability-use.v1"
  }
}
