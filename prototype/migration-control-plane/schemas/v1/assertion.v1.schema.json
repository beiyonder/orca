{
  "$id": "urn:orca:migration-control-plane:assertion.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicability": {
      "enum": ["in-scope", "out-of-scope", "partial", "unknown"],
      "type": "string"
    },
    "assertedBy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": ["system", "operator", "apex", "specialist", "evaluator", "adapter"],
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "derivationAssertionIds": {
      "items": {
        "maxLength": 128,
        "minLength": 11,
        "pattern": "^assertion_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "directness": {
      "enum": ["direct", "derived"],
      "type": "string"
    },
    "evidenceId": {
      "maxLength": 128,
      "minLength": 10,
      "pattern": "^evidence_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 11,
      "pattern": "^assertion_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "kind": {
      "const": "assertion",
      "type": "string"
    },
    "missionId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^mission_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "polarity": {
      "enum": ["supports", "refutes"],
      "type": "string"
    },
    "propositionId": {
      "maxLength": 128,
      "minLength": 13,
      "pattern": "^proposition_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "rationale": {
      "maxLength": 8192,
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "missionId",
    "createdAt",
    "propositionId",
    "evidenceId",
    "polarity",
    "directness",
    "applicability",
    "derivationAssertionIds",
    "rationale",
    "assertedBy"
  ],
  "title": "assertion.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "assertion.v1"
  }
}
