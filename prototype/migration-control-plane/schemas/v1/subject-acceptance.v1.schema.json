{
  "$id": "urn:orca:migration-control-plane:subject-acceptance.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptanceAuthority": {
      "const": "product-reconciler",
      "type": "string"
    },
    "acceptanceKey": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "contract": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 21,
          "pattern": "^evaluation_contract_[a-z0-9][a-z0-9_-]{0,111}$",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": ["id", "version", "digest"],
      "type": "object"
    },
    "coordinationIds": {
      "items": {
        "maxLength": 128,
        "minLength": 25,
        "pattern": "^evaluation_coordination_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "evaluationResultIds": {
      "items": {
        "maxLength": 128,
        "minLength": 19,
        "pattern": "^evaluation_result_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 0,
      "type": "array"
    },
    "evidenceIds": {
      "items": {
        "maxLength": 128,
        "minLength": 10,
        "pattern": "^evidence_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 0,
      "type": "array"
    },
    "id": {
      "maxLength": 128,
      "minLength": 20,
      "pattern": "^subject_acceptance_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "kind": {
      "const": "subject-acceptance",
      "type": "string"
    },
    "missionId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^mission_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "predecessor": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "id": {
              "maxLength": 128,
              "minLength": 20,
              "pattern": "^subject_acceptance_[a-z0-9][a-z0-9_-]{0,111}$",
              "type": "string"
            },
            "version": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": ["id", "version", "digest"],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "satisfiedPredicates": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "status": {
      "enum": ["unknown", "hypothesis", "supported", "accepted", "rejected", "quarantined"],
      "type": "string"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "schema": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "name": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9-]*\\.v[1-9][0-9]*$",
              "type": "string"
            },
            "version": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": ["name", "version", "digest"],
          "type": "object"
        },
        "version": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": ["kind", "schema", "id", "version", "digest"],
      "type": "object"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "transitionedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "transitionedBy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": ["system", "operator", "apex", "specialist", "evaluator", "adapter"],
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "unsatisfiedPredicates": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "version": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "missionId",
    "createdAt",
    "acceptanceKey",
    "version",
    "predecessor",
    "subject",
    "contract",
    "status",
    "coordinationIds",
    "evaluationResultIds",
    "satisfiedPredicates",
    "unsatisfiedPredicates",
    "evidenceIds",
    "reason",
    "transitionedAt",
    "transitionedBy",
    "acceptanceAuthority"
  ],
  "title": "subject-acceptance.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "subject-acceptance.v1"
  }
}
