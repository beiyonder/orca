{
  "$id": "urn:orca:migration-control-plane:source-code-extract.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "mediaType": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[a-z0-9!#$&^_.+-]+\\/[a-z0-9!#$&^_.+-]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "span": {
          "default": {
            "kind": "whole"
          },
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "whole",
                  "type": "string"
                }
              },
              "required": ["kind"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "endLine": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "kind": {
                  "const": "text-lines",
                  "type": "string"
                },
                "startLine": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                }
              },
              "required": ["kind", "startLine", "endLine"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "json-pointer",
                  "type": "string"
                },
                "pointer": {
                  "maxLength": 4096,
                  "pattern": "^(?:\\/[^/]*)*$",
                  "type": "string"
                }
              },
              "required": ["kind", "pointer"],
              "type": "object"
            }
          ]
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9+.-]*:",
          "type": "string"
        }
      },
      "required": ["uri", "sha256", "mediaType", "bytes", "span"],
      "type": "object"
    },
    "contentDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "denied": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "extracted": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "requestedKinds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "unavailable": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": ["requestedKinds", "extracted", "denied", "unavailable", "complete"],
      "type": "object"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 21,
      "pattern": "^source_code_extract_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "kind": {
      "const": "source-code-extract",
      "type": "string"
    },
    "lineage": {
      "additionalProperties": false,
      "properties": {
        "capturedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        "capturedBy": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "kind": {
              "enum": ["system", "operator", "apex", "specialist", "evaluator", "adapter"],
              "type": "string"
            },
            "version": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": ["kind", "id"],
          "type": "object"
        },
        "observationId": {
          "maxLength": 128,
          "minLength": 20,
          "pattern": "^source_observation_[a-z0-9][a-z0-9_-]{0,111}$",
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^source_request_[a-z0-9][a-z0-9_-]{0,111}$",
          "type": "string"
        },
        "snapshotToken": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "databaseName": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "endpointDigest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "engine": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "engineVersion": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "fixtureDigest": {
              "anyOf": [
                {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sourceSystemId": {
              "maxLength": 128,
              "minLength": 15,
              "pattern": "^source_system_[a-z0-9][a-z0-9_-]{0,111}$",
              "type": "string"
            }
          },
          "required": [
            "sourceSystemId",
            "engine",
            "engineVersion",
            "databaseName",
            "endpointDigest",
            "fixtureDigest"
          ],
          "type": "object"
        }
      },
      "required": [
        "source",
        "requestId",
        "observationId",
        "snapshotToken",
        "capturedAt",
        "capturedBy"
      ],
      "type": "object"
    },
    "objects": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifactPointer": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "definitionDigest": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "dependencyHints": {
            "items": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 10000,
            "type": "array"
          },
          "kind": {
            "enum": ["view", "materialized-view", "function", "procedure", "trigger"],
            "type": "string"
          },
          "language": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "limitations": {
            "items": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 64,
            "type": "array"
          },
          "object": {
            "additionalProperties": false,
            "properties": {
              "identity": {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              "name": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "schema": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": ["schema", "name", "identity"],
            "type": "object"
          }
        },
        "required": [
          "object",
          "kind",
          "language",
          "definitionDigest",
          "artifactPointer",
          "dependencyHints",
          "limitations"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "createdAt",
    "lineage",
    "artifact",
    "contentDigest",
    "objects",
    "coverage"
  ],
  "title": "source-code-extract.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "source-code-extract.v1"
  }
}
