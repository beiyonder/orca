            "required": ["operation", "taskId", "childTaskIds"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "merge-tasks",
                "type": "string"
              },
              "sourceTaskIds": {
                "items": {
                  "maxLength": 128,
                  "minLength": 6,
                  "pattern": "^task_[a-z0-9][a-z0-9_-]{0,111}$",
