              "taskId": {
                "maxLength": 128,
                "minLength": 6,
                "pattern": "^task_[a-z0-9][a-z0-9_-]{0,111}$",
                "type": "string"
              }
            },
            "required": ["operation", "taskId", "reason"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "supersede-task",
                "type": "string"
