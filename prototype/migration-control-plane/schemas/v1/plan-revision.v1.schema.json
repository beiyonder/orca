                "maxItems": 128,
                "minItems": 1,
                "type": "array"
              },
              "taskId": {
                "maxLength": 128,
                "minLength": 6,
                "pattern": "^task_[a-z0-9][a-z0-9_-]{0,111}$",
                "type": "string"
              }
            },
            "required": ["operation", "taskId", "replacementTaskIds"],
            "type": "object"
          }
        ]
