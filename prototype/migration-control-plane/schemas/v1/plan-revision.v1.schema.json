                },
                "maxItems": 128,
                "minItems": 2,
                "type": "array"
              },
              "targetTaskId": {
                "maxLength": 128,
                "minLength": 6,
                "pattern": "^task_[a-z0-9][a-z0-9_-]{0,111}$",
                "type": "string"
