                },
                "maxItems": 1000,
                "minItems": 0,
                "type": "array"
              },
              "operation": {
                "const": "add-task",
                "type": "string"
              },
              "proofObligations": {
                "items": {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
