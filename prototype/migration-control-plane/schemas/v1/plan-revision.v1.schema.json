                  },
                  "onWorkerLoss": {
                    "enum": ["retry", "reconstruct", "quarantine", "fail"],
                    "type": "string"
                  },
                  "requiresEvaluation": {
                    "type": "boolean"
                  }
                },
                "required": ["onWorkerLoss", "onStaleResult", "maxAttempts", "requiresEvaluation"],
                "type": "object"
              },
              "taskId": {
                "maxLength": 128,
                "minLength": 6,
                "pattern": "^task_[a-z0-9][a-z0-9_-]{0,111}$",
                "type": "string"
              },
              "title": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "operation",
              "taskId",
              "title",
              "capability",
              "dependencyTaskIds",
              "proofObligations",
              "recoveryPolicy"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "childTaskIds": {
                "items": {
                  "maxLength": 128,
                  "minLength": 6,
                  "pattern": "^task_[a-z0-9][a-z0-9_-]{0,111}$",
                  "type": "string"
                },
                "maxItems": 128,
                "minItems": 2,
                "type": "array"
              },
              "operation": {
                "const": "split-task",
