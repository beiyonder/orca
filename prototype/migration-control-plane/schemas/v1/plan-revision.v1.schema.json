  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "missionId",
    "createdAt",
    "revision",
    "basePlanRevisionId",
    "baseMissionRevision",
    "operations",
    "decisionIds",
    "evidenceIds",
    "findingIds",
    "rationale",
    "createdBy",
    "committedAt"
