            },
            "required": ["operation", "sourceTaskIds", "targetTaskId"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "dependencyTaskId": {
                "maxLength": 128,
                "minLength": 6,
                "pattern": "^task_[a-z0-9][a-z0-9_-]{0,111}$",
                "type": "string"
              },
              "operation": {
                "const": "add-dependency",
                "type": "string"
              },
              "taskId": {
                "maxLength": 128,
                "minLength": 6,
                "pattern": "^task_[a-z0-9][a-z0-9_-]{0,111}$",
                "type": "string"
              }
            },
            "required": ["operation", "taskId", "dependencyTaskId"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "gapIds": {
                "items": {
                  "maxLength": 128,
                  "minLength": 5,
                  "pattern": "^gap_[a-z0-9][a-z0-9_-]{0,111}$",
                  "type": "string"
                },
                "maxItems": 1000,
                "minItems": 1,
                "type": "array"
              },
              "operation": {
                "const": "block-task",
                "type": "string"
              },
              "taskId": {
                "maxLength": 128,
                "minLength": 6,
                "pattern": "^task_[a-z0-9][a-z0-9_-]{0,111}$",
                "type": "string"
              }
            },
            "required": ["operation", "taskId", "gapIds"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "unblock-task",
                "type": "string"
              },
              "resolvedGapIds": {
                "items": {
                  "maxLength": 128,
                  "minLength": 5,
                  "pattern": "^gap_[a-z0-9][a-z0-9_-]{0,111}$",
                  "type": "string"
                },
                "maxItems": 1000,
                "minItems": 1,
                "type": "array"
              },
              "taskId": {
                "maxLength": 128,
                "minLength": 6,
                "pattern": "^task_[a-z0-9][a-z0-9_-]{0,111}$",
                "type": "string"
              }
            },
            "required": ["operation", "taskId", "resolvedGapIds"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "cancel-task",
                "type": "string"
              },
              "reason": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "taskId": {
                "maxLength": 128,
                "minLength": 6,
                "pattern": "^task_[a-z0-9][a-z0-9_-]{0,111}$",
                "type": "string"
              }
            },
            "required": ["operation", "taskId", "reason"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "quarantine-task",
                "type": "string"
              },
              "reason": {
                "maxLength": 512,
                "minLength": 1,
