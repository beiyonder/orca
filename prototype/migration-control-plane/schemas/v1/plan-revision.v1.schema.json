    "rationale": {
      "maxLength": 32768,
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
