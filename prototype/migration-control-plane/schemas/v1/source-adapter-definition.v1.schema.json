{
  "$id": "urn:orca:migration-control-plane:source-adapter-definition.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapterId": {
      "maxLength": 128,
      "minLength": 16,
      "pattern": "^source_adapter_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "mediaType": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[a-z0-9!#$&^_.+-]+\\/[a-z0-9!#$&^_.+-]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "span": {
          "default": {
            "kind": "whole"
          },
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "whole",
                  "type": "string"
                }
              },
              "required": ["kind"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "endLine": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "kind": {
                  "const": "text-lines",
                  "type": "string"
                },
                "startLine": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                }
              },
              "required": ["kind", "startLine", "endLine"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "json-pointer",
                  "type": "string"
                },
                "pointer": {
                  "maxLength": 4096,
                  "pattern": "^(?:\\/[^/]*)*$",
                  "type": "string"
                }
              },
              "required": ["kind", "pointer"],
              "type": "object"
            }
          ]
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9+.-]*:",
          "type": "string"
        }
      },
      "required": ["uri", "sha256", "mediaType", "bytes", "span"],
      "type": "object"
    },
    "artifactDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "authority": {
      "additionalProperties": false,
      "properties": {
        "allowsArbitrarySql": {
          "const": false,
          "type": "boolean"
        },
        "filesystemScopes": {
          "prefixItems": [],
          "type": "array"
        },
        "mode": {
          "const": "read-only",
          "type": "string"
        },
        "mutationVocabulary": {
          "prefixItems": [],
          "type": "array"
        },
        "transactionMode": {
          "const": "read-only",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "transactionMode",
        "mutationVocabulary",
        "filesystemScopes",
        "allowsArbitrarySql"
      ],
      "type": "object"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "createdBy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": ["system", "operator", "apex", "specialist", "evaluator", "adapter"],
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "dataClasses": {
      "items": {
        "enum": ["synthetic", "public", "internal", "confidential", "restricted", "phi"],
        "type": "string"
      },
      "maxItems": 6,
      "minItems": 1,
      "type": "array"
    },
    "defaultLimits": {
      "additionalProperties": false,
      "properties": {
        "byteLimit": {
          "exclusiveMinimum": 0,
          "maximum": 1073741824,
          "type": "integer"
        },
        "concurrencyLimit": {
          "exclusiveMinimum": 0,
          "maximum": 128,
          "type": "integer"
        },
        "queryLimit": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "type": "integer"
        },
        "rowLimit": {
          "maximum": 10000000,
          "minimum": 0,
          "type": "integer"
        },
        "statementTimeoutMs": {
          "exclusiveMinimum": 0,
          "maximum": 600000,
          "type": "integer"
        },
        "timeLimitMs": {
          "exclusiveMinimum": 0,
          "maximum": 3600000,
          "type": "integer"
        }
      },
      "required": [
        "timeLimitMs",
        "statementTimeoutMs",
        "queryLimit",
        "rowLimit",
        "byteLimit",
        "concurrencyLimit"
      ],
      "type": "object"
    },
    "description": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    },
    "errorRecovery": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "access-denied",
              "unsupported-operation",
              "unsupported-version",
              "source-unavailable",
              "mutation-blocked",
              "network-denied",
              "filesystem-denied",
              "concurrency-limit-exceeded",
              "source-changed",
              "deadline-exceeded",
              "query-limit-exceeded",
              "row-limit-exceeded",
              "byte-limit-exceeded",
              "malformed-source-result",
              "cancelled",
              "adapter-failed"
            ],
            "type": "string"
          },
          "operatorAction": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "preservesPartialEvidence": {
            "type": "boolean"
          },
          "retry": {
            "enum": ["never", "same-snapshot", "after-reconnect", "after-permission-change"],
            "type": "string"
          }
        },
        "required": ["code", "retry", "preservesPartialEvidence", "operatorAction"],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "id": {
      "maxLength": 128,
      "minLength": 27,
      "pattern": "^source_adapter_definition_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "kind": {
      "const": "source-adapter-definition",
      "type": "string"
    },
    "license": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "operations": {
      "items": {
        "enum": [
          "inventory-system",
          "inventory-schema",
          "profile-data",
          "extract-code",
          "infer-lineage",
          "inspect-cdc",
          "run-safe-probe",
          "inspect-capabilities"
        ],
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array"
    },
    "predecessorDefinitionId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 27,
          "pattern": "^source_adapter_definition_[a-z0-9][a-z0-9_-]{0,111}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "signer": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "supportedSources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "engine": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "requiredFeatures": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 128,
            "type": "array"
          },
          "unsupportedFeatures": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 128,
            "type": "array"
          },
          "versionConstraint": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["engine", "versionConstraint", "requiredFeatures", "unsupportedFeatures"],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "version": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "createdAt",
    "adapterId",
    "version",
    "artifact",
    "artifactDigest",
    "description",
    "supportedSources",
    "operations",
    "dataClasses",
    "defaultLimits",
    "errorRecovery",
    "authority",
    "predecessorDefinitionId",
    "license",
    "signer",
    "createdBy"
  ],
  "title": "source-adapter-definition.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "source-adapter-definition.v1"
  }
}
