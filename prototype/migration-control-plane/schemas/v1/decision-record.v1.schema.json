{
  "$id": "urn:orca:migration-control-plane:decision-record.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assertionIds": {
      "items": {
        "maxLength": 128,
        "minLength": 11,
        "pattern": "^assertion_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "assumptions": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "type": "array"
    },
    "baseMissionRevision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "decidedBy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": ["system", "operator", "apex", "specialist", "evaluator", "adapter"],
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "evidenceIds": {
      "items": {
        "maxLength": 128,
        "minLength": 10,
        "pattern": "^evidence_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "findingIds": {
      "items": {
        "maxLength": 128,
        "minLength": 9,
        "pattern": "^finding_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "id": {
      "maxLength": 128,
      "minLength": 10,
      "pattern": "^decision_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "impactRecordIds": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "kind": {
      "const": "decision-record",
      "type": "string"
    },
    "missionId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^mission_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "options": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 32768,
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "label": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "tradeoffs": {
            "items": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 64,
            "type": "array"
          }
        },
        "required": ["id", "label", "description", "tradeoffs"],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 2,
      "type": "array"
    },
    "probeResultIds": {
      "items": {
        "maxLength": 128,
        "minLength": 14,
        "pattern": "^probe_result_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "question": {
      "maxLength": 32768,
      "minLength": 1,
      "type": "string"
    },
    "rationale": {
      "maxLength": 32768,
      "minLength": 1,
      "type": "string"
    },
    "reversalConditions": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "selectedOptionId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "missionId",
    "createdAt",
    "revision",
    "baseMissionRevision",
    "question",
    "options",
    "selectedOptionId",
    "evidenceIds",
    "assertionIds",
    "findingIds",
    "probeResultIds",
    "assumptions",
    "impactRecordIds",
    "reversalConditions",
    "rationale",
    "decidedBy"
  ],
  "title": "decision-record.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "decision-record.v1"
  }
}
