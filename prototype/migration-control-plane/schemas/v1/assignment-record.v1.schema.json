{
  "$id": "urn:orca:migration-control-plane:assignment-record.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignedBy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": ["system", "operator", "apex", "specialist", "evaluator", "adapter"],
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "budget": {
      "additionalProperties": false,
      "properties": {
        "costLimitUsd": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "number"
        },
        "outputByteLimit": {
          "exclusiveMinimum": 0,
          "maximum": 67108864,
          "type": "integer"
        },
        "timeLimitMs": {
          "exclusiveMinimum": 0,
          "maximum": 86400000,
          "type": "integer"
        },
        "tokenLimit": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "toolCallLimit": {
          "maximum": 100000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["tokenLimit", "timeLimitMs", "toolCallLimit", "outputByteLimit", "costLimitUsd"],
      "type": "object"
    },
    "contextManifestId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^context_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "contractVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 12,
      "pattern": "^assignment_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "kind": {
      "const": "assignment",
      "type": "string"
    },
    "missionId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^mission_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "modelRoute": {
      "additionalProperties": false,
      "properties": {
        "dataClasses": {
          "items": {
            "enum": ["synthetic", "public", "internal", "confidential", "restricted", "phi"],
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array"
        },
        "effort": {
          "enum": ["lo", "med", "hi"],
          "type": "string"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["provider", "model", "revision", "effort", "dataClasses"],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "mode": {
          "const": "strict",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*\\.v[1-9][0-9]*$",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": ["name", "version", "digest", "mode"],
      "type": "object"
    },
    "requiredEvaluationContractIds": {
      "items": {
        "maxLength": 128,
        "minLength": 21,
        "pattern": "^evaluation_contract_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 0,
      "type": "array"
    },
    "revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "role": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "spawnPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowedRoles": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        "enabled": {
          "type": "boolean"
        },
        "maxDepth": {
          "maximum": 8,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["enabled", "maxDepth", "allowedRoles"],
      "type": "object"
    },
    "state": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": ["created", "dispatching", "active", "correcting"],
              "type": "string"
            }
          },
          "required": ["status"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "completedAt": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            "reason": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "status": {
              "enum": ["completed", "failed", "cancelled", "quarantined"],
              "type": "string"
            }
          },
          "required": ["status", "reason", "completedAt"],
          "type": "object"
        }
      ]
    },
    "taskId": {
      "maxLength": 128,
      "minLength": 6,
      "pattern": "^task_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "tools": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "approval": {
            "enum": ["read", "write", "exec"],
            "type": "string"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "schemaDigest": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "version": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["name", "version", "schemaDigest", "approval"],
        "type": "object"
      },
      "maxItems": 128,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "missionId",
    "createdAt",
    "revision",
    "taskId",
    "role",
    "contractVersion",
    "contextManifestId",
    "tools",
    "outputSchema",
    "modelRoute",
    "budget",
    "spawnPolicy",
    "requiredEvaluationContractIds",
    "state",
    "assignedBy"
  ],
  "title": "assignment-record.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "assignment-record.v1"
  }
}
