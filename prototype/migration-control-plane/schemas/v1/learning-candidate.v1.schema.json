{
  "$id": "urn:orca:migration-control-plane:learning-candidate.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowedMutationPaths": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array"
    },
    "authorityDelta": {
      "enum": ["none", "separate-approval-required"],
      "type": "string"
    },
    "candidateType": {
      "enum": [
        "memory",
        "context-policy",
        "prompt-program",
        "skill",
        "tool",
        "model-route",
        "evaluator",
        "corpus",
        "model-weights"
      ],
      "type": "string"
    },
    "causalHypothesis": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 10,
      "pattern": "^learning_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "kind": {
      "const": "learning-candidate",
      "type": "string"
    },
    "missionId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^mission_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "proposedArtifact": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "mediaType": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[a-z0-9!#$&^_.+-]+\\/[a-z0-9!#$&^_.+-]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "span": {
          "default": {
            "kind": "whole"
          },
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "whole",
                  "type": "string"
                }
              },
              "required": ["kind"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "endLine": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "kind": {
                  "const": "text-lines",
                  "type": "string"
                },
                "startLine": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                }
              },
              "required": ["kind", "startLine", "endLine"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "json-pointer",
                  "type": "string"
                },
                "pointer": {
                  "maxLength": 4096,
                  "pattern": "^(?:\\/[^/]*)*$",
                  "type": "string"
                }
              },
              "required": ["kind", "pointer"],
              "type": "object"
            }
          ]
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9+.-]*:",
          "type": "string"
        }
      },
      "required": ["uri", "sha256", "mediaType", "bytes", "span"],
      "type": "object"
    },
    "proposedBy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": ["system", "operator", "apex", "specialist", "evaluator", "adapter"],
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "retentionExpiresAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "sourceEvaluationResultIds": {
      "items": {
        "maxLength": 128,
        "minLength": 19,
        "pattern": "^evaluation_result_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "sourceEvidenceIds": {
      "items": {
        "maxLength": 128,
        "minLength": 10,
        "pattern": "^evidence_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 1,
      "type": "array"
    },
    "sourceRecordIds": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 1,
      "type": "array"
    },
    "state": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "quarantined",
              "type": "string"
            },
            "usePolicy": {
              "const": "none",
              "type": "string"
            },
            "validationStatus": {
              "const": "not-run",
              "type": "string"
            }
          },
          "required": ["status", "usePolicy", "validationStatus"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": ["eligible", "experimenting"],
              "type": "string"
            },
            "usePolicy": {
              "const": "offline-only",
              "type": "string"
            },
            "validationStatus": {
              "enum": ["planned", "running"],
              "type": "string"
            }
          },
          "required": ["status", "usePolicy", "validationStatus"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "certificationId": {
              "maxLength": 128,
              "minLength": 15,
              "pattern": "^certification_[a-z0-9][a-z0-9_-]{0,111}$",
              "type": "string"
            },
            "reason": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "settledAt": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            "status": {
              "enum": ["certified", "rejected", "revoked"],
              "type": "string"
            }
          },
          "required": ["status", "certificationId", "reason", "settledAt"],
          "type": "object"
        }
      ]
    },
    "targetEnvelope": {
      "additionalProperties": false,
      "properties": {
        "dataClasses": {
          "items": {
            "enum": ["synthetic", "public", "internal", "confidential", "restricted", "phi"],
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array"
        },
        "environment": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "modelRoutes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "dataClasses": {
                "items": {
                  "enum": ["synthetic", "public", "internal", "confidential", "restricted", "phi"],
                  "type": "string"
                },
                "maxItems": 6,
                "minItems": 1,
                "type": "array"
              },
              "effort": {
                "enum": ["lo", "med", "hi"],
                "type": "string"
              },
              "model": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "provider": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "revision": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": ["provider", "model", "revision", "effort", "dataClasses"],
            "type": "object"
          },
          "maxItems": 64,
          "type": "array"
        },
        "taskClasses": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": ["taskClasses", "modelRoutes", "dataClasses", "environment"],
      "type": "object"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "missionId",
    "createdAt",
    "candidateType",
    "sourceEvaluationResultIds",
    "sourceEvidenceIds",
    "sourceRecordIds",
    "causalHypothesis",
    "proposedArtifact",
    "targetEnvelope",
    "allowedMutationPaths",
    "authorityDelta",
    "retentionExpiresAt",
    "state",
    "proposedBy"
  ],
  "title": "learning-candidate.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "learning-candidate.v1"
  }
}
