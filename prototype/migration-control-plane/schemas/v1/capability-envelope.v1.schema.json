{
  "$id": "urn:orca:migration-control-plane:capability-envelope.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapterMethod": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "adapterName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "allowedNetworkDestinations": {
      "items": {
        "maxLength": 4096,
        "minLength": 3,
        "pattern": "^[a-z][a-z0-9+.-]*:",
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "allowedTools": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "approval": {
            "enum": ["read", "write", "exec"],
            "type": "string"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "schemaDigest": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "version": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["name", "version", "schemaDigest", "approval"],
        "type": "object"
      },
      "maxItems": 128,
      "type": "array"
    },
    "budget": {
      "additionalProperties": false,
      "properties": {
        "costLimitUsd": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "number"
        },
        "outputByteLimit": {
          "exclusiveMinimum": 0,
          "maximum": 67108864,
          "type": "integer"
        },
        "timeLimitMs": {
          "exclusiveMinimum": 0,
          "maximum": 86400000,
          "type": "integer"
        },
        "tokenLimit": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "toolCallLimit": {
          "maximum": 100000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["tokenLimit", "timeLimitMs", "toolCallLimit", "outputByteLimit", "costLimitUsd"],
      "type": "object"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "dataClasses": {
      "items": {
        "enum": ["synthetic", "public", "internal", "confidential", "restricted", "phi"],
        "type": "string"
      },
      "maxItems": 6,
      "minItems": 1,
      "type": "array"
    },
    "effectId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^effect_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 10,
      "pattern": "^envelope_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "intentDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "issuedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "kind": {
      "const": "capability-envelope",
      "type": "string"
    },
    "maxUses": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "type": "integer"
    },
    "missionId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^mission_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "parameterDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "policyDecisionId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^policy_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "revokedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "secretLeaseIds": {
      "items": {
        "maxLength": 128,
        "minLength": 14,
        "pattern": "^secret_lease_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 0,
      "type": "array"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "resourceId": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "resourceType": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["provider", "account", "project", "region", "resourceType", "resourceId"],
      "type": "object"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "workload": {
      "additionalProperties": false,
      "properties": {
        "assignmentId": {
          "maxLength": 128,
          "minLength": 12,
          "pattern": "^assignment_[a-z0-9][a-z0-9_-]{0,111}$",
          "type": "string"
        },
        "attemptId": {
          "maxLength": 128,
          "minLength": 9,
          "pattern": "^attempt_[a-z0-9][a-z0-9_-]{0,111}$",
          "type": "string"
        },
        "audience": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "fence": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": ["assignmentId", "attemptId", "fence", "audience"],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "missionId",
    "createdAt",
    "effectId",
    "intentDigest",
    "policyDecisionId",
    "workload",
    "target",
    "adapterName",
    "adapterMethod",
    "parameterDigest",
    "allowedTools",
    "allowedNetworkDestinations",
    "dataClasses",
    "secretLeaseIds",
    "budget",
    "maxUses",
    "issuedAt",
    "expiresAt",
    "revokedAt"
  ],
  "title": "capability-envelope.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "capability-envelope.v1"
  }
}
