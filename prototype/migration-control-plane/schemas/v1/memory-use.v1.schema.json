{
  "$id": "urn:orca:migration-control-plane:memory-use.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignmentId": {
      "maxLength": 128,
      "minLength": 12,
      "pattern": "^assignment_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "attemptId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^attempt_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "attribution": {
      "enum": ["helped", "neutral", "harmed", "unknown"],
      "type": "string"
    },
    "channel": {
      "enum": ["structured", "lexical", "semantic", "graph"],
      "type": "string"
    },
    "contextManifestId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^context_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "downstreamRecordIds": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "id": {
      "maxLength": 128,
      "minLength": 12,
      "pattern": "^memory_use_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "kind": {
      "const": "memory-use",
      "type": "string"
    },
    "memoryVersionId": {
      "maxLength": 128,
      "minLength": 16,
      "pattern": "^memory_version_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "rank": {
      "exclusiveMinimum": 0,
      "maximum": 10000,
      "type": "integer"
    },
    "renderedDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "retrievalQueryId": {
      "maxLength": 128,
      "minLength": 17,
      "pattern": "^retrieval_query_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "retrievalTraceId": {
      "maxLength": 128,
      "minLength": 17,
      "pattern": "^retrieval_trace_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "score": {
      "minimum": 0,
      "type": "number"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "createdAt",
    "memoryVersionId",
    "contextManifestId",
    "assignmentId",
    "attemptId",
    "retrievalQueryId",
    "retrievalTraceId",
    "channel",
    "rank",
    "score",
    "renderedDigest",
    "downstreamRecordIds",
    "attribution"
  ],
  "title": "memory-use.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "memory-use.v1"
  }
}
