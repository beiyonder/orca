{
  "$id": "urn:orca:migration-control-plane:gap.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blockedDecisionIds": {
      "items": {
        "maxLength": 128,
        "minLength": 10,
        "pattern": "^decision_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "contradictionIds": {
      "items": {
        "maxLength": 128,
        "minLength": 15,
        "pattern": "^contradiction_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "hypothesisIds": {
      "items": {
        "maxLength": 128,
        "minLength": 13,
        "pattern": "^proposition_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "id": {
      "maxLength": 128,
      "minLength": 5,
      "pattern": "^gap_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "impact": {
      "enum": ["low", "medium", "high", "critical"],
      "type": "string"
    },
    "kind": {
      "const": "gap",
      "type": "string"
    },
    "missionId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^mission_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "probeCandidateIds": {
      "items": {
        "maxLength": 128,
        "minLength": 7,
        "pattern": "^probe_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "propositionIds": {
      "items": {
        "maxLength": 128,
        "minLength": 13,
        "pattern": "^proposition_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "question": {
      "maxLength": 32768,
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "state": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "status": {
              "enum": ["open", "investigating"],
              "type": "string"
            }
          },
          "required": ["status", "reason"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "blockerIds": {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 1000,
              "minItems": 1,
              "type": "array"
            },
            "reason": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "status": {
              "const": "blocked",
              "type": "string"
            }
          },
          "required": ["status", "reason", "blockerIds"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "acceptedFindingId": {
              "maxLength": 128,
              "minLength": 9,
              "pattern": "^finding_[a-z0-9][a-z0-9_-]{0,111}$",
              "type": "string"
            },
            "resolvedAt": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            "status": {
              "const": "resolved",
              "type": "string"
            }
          },
          "required": ["status", "acceptedFindingId", "resolvedAt"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "quarantinedAt": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            "reason": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "status": {
              "const": "quarantined",
              "type": "string"
            }
          },
          "required": ["status", "reason", "quarantinedAt"],
          "type": "object"
        }
      ]
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "missionId",
    "createdAt",
    "revision",
    "question",
    "impact",
    "propositionIds",
    "hypothesisIds",
    "contradictionIds",
    "probeCandidateIds",
    "blockedDecisionIds",
    "state"
  ],
  "title": "gap.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "gap.v1"
  }
}
