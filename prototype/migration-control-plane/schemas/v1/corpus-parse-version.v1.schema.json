{
  "$id": "urn:orca:migration-control-plane:corpus-parse-version.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 14,
      "pattern": "^corpus_parse_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "kind": {
      "const": "corpus-parse-version",
      "type": "string"
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "mediaType": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[a-z0-9!#$&^_.+-]+\\/[a-z0-9!#$&^_.+-]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "span": {
          "default": {
            "kind": "whole"
          },
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "whole",
                  "type": "string"
                }
              },
              "required": ["kind"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "endLine": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "kind": {
                  "const": "text-lines",
                  "type": "string"
                },
                "startLine": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                }
              },
              "required": ["kind", "startLine", "endLine"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "json-pointer",
                  "type": "string"
                },
                "pointer": {
                  "maxLength": 4096,
                  "pattern": "^(?:\\/[^/]*)*$",
                  "type": "string"
                }
              },
              "required": ["kind", "pointer"],
              "type": "object"
            }
          ]
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9+.-]*:",
          "type": "string"
        }
      },
      "required": ["uri", "sha256", "mediaType", "bytes", "span"],
      "type": "object"
    },
    "parsedBy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": ["system", "operator", "apex", "specialist", "evaluator", "adapter"],
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "parser": {
      "additionalProperties": false,
      "properties": {
        "implementationDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["name", "version", "implementationDigest"],
      "type": "object"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "sourceDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "sourceId": {
      "maxLength": 128,
      "minLength": 15,
      "pattern": "^corpus_source_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "sourceManifestId": {
      "maxLength": 128,
      "minLength": 17,
      "pattern": "^corpus_manifest_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "sourceVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "warnings": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "createdAt",
    "sourceManifestId",
    "sourceId",
    "sourceVersion",
    "sourceDigest",
    "parser",
    "output",
    "warnings",
    "parsedBy"
  ],
  "title": "corpus-parse-version.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "corpus-parse-version.v1"
  }
}
