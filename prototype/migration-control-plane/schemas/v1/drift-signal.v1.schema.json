  "$id": "urn:orca:migration-control-plane:drift-signal.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": ["observe", "pause", "demote", "revoke", "recertify"],
      "type": "string"
    },
    "affectedUseIds": {
      "items": {
        "maxLength": 128,
        "minLength": 16,
        "pattern": "^capability_use_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 100000,
      "minItems": 0,
      "type": "array"
    },
    "baselineDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "capabilityId": {
      "maxLength": 128,
      "minLength": 12,
      "pattern": "^capability_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "capabilityVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "detectedBy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": ["system", "operator", "apex", "specialist", "evaluator", "adapter"],
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "id": {
      "maxLength": 128,
      "minLength": 7,
      "pattern": "^drift_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "kind": {
      "const": "drift-signal",
      "type": "string"
    },
    "measures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidenceIds": {
            "items": {
              "maxLength": 128,
              "minLength": 10,
              "pattern": "^evidence_[a-z0-9][a-z0-9_-]{0,111}$",
              "type": "string"
            },
            "maxItems": 10000,
            "minItems": 0,
            "type": "array"
          },
          "failureCode": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": ["pass", "fail", "unknown"],
            "type": "string"
          },
          "threshold": {
            "$ref": "#/$defs/__schema0"
          },
          "value": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": ["name", "status", "value", "threshold", "evidenceIds", "failureCode"],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "severity": {
      "enum": ["info", "warning", "critical"],
      "type": "string"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "windowEndedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "windowStartedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "createdAt",
    "capabilityId",
    "capabilityVersion",
    "windowStartedAt",
    "windowEndedAt",
    "baselineDigest",
    "measures",
    "affectedUseIds",
    "severity",
    "action",
    "detectedBy"
  ],
  "title": "drift-signal.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "drift-signal.v1"
  }
}
