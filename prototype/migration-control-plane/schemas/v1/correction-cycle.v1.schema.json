{
  "$id": "urn:orca:migration-control-plane:correction-cycle.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptanceAuthority": {
      "const": "none",
      "type": "string"
    },
    "addedEvidenceIds": {
      "items": {
        "maxLength": 128,
        "minLength": 10,
        "pattern": "^evidence_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 0,
      "type": "array"
    },
    "allowedMutationPaths": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array"
    },
    "attempt": {
      "exclusiveMinimum": 0,
      "maximum": 100,
      "type": "integer"
    },
    "changedPaths": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "correctedSubject": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "kind": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "schema": {
              "additionalProperties": false,
              "properties": {
                "digest": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "name": {
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9-]*\\.v[1-9][0-9]*$",
                  "type": "string"
                },
                "version": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                }
              },
              "required": ["name", "version", "digest"],
              "type": "object"
            },
            "version": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": ["kind", "schema", "id", "version", "digest"],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "correctionKey": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "diagnosisId": {
      "maxLength": 128,
      "minLength": 22,
      "pattern": "^evaluation_diagnosis_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "evaluationResultIds": {
      "items": {
        "maxLength": 128,
        "minLength": 19,
        "pattern": "^evaluation_result_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 0,
      "type": "array"
    },
    "evaluatorChanged": {
      "const": false,
      "type": "boolean"
    },
    "failedAcceptanceId": {
      "maxLength": 128,
      "minLength": 20,
      "pattern": "^subject_acceptance_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "fixedContract": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 21,
          "pattern": "^evaluation_contract_[a-z0-9][a-z0-9_-]{0,111}$",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": ["id", "version", "digest"],
      "type": "object"
    },
    "id": {
      "maxLength": 128,
      "minLength": 18,
      "pattern": "^correction_cycle_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "kind": {
      "const": "correction-cycle",
      "type": "string"
    },
    "maxAttempts": {
      "exclusiveMinimum": 0,
      "maximum": 100,
      "type": "integer"
    },
    "missionId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^mission_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "originalSubject": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "schema": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "name": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9-]*\\.v[1-9][0-9]*$",
              "type": "string"
            },
            "version": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": ["name", "version", "digest"],
          "type": "object"
        },
        "version": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": ["kind", "schema", "id", "version", "digest"],
      "type": "object"
    },
    "predecessor": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "id": {
              "maxLength": 128,
              "minLength": 18,
              "pattern": "^correction_cycle_[a-z0-9][a-z0-9_-]{0,111}$",
              "type": "string"
            },
            "version": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": ["id", "version", "digest"],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "recordedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "recordedBy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": ["system", "operator", "apex", "specialist", "evaluator", "adapter"],
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "status": {
      "enum": ["requested", "produced", "evaluating", "passed", "failed", "quarantined"],
      "type": "string"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "thresholdChanged": {
      "const": false,
      "type": "boolean"
    },
    "usage": {
      "additionalProperties": false,
      "properties": {
        "cacheReadTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "cacheWriteTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "costUsd": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "number"
        },
        "inputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "outputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "toolCalls": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "wallTimeMs": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "cacheReadTokens",
        "cacheWriteTokens",
        "toolCalls",
        "wallTimeMs",
        "costUsd"
      ],
      "type": "object"
    },
    "version": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "missionId",
    "createdAt",
    "correctionKey",
    "version",
    "predecessor",
    "failedAcceptanceId",
    "diagnosisId",
    "originalSubject",
    "correctedSubject",
    "fixedContract",
    "attempt",
    "maxAttempts",
    "allowedMutationPaths",
    "changedPaths",
    "addedEvidenceIds",
    "evaluationResultIds",
    "evaluatorChanged",
    "thresholdChanged",
    "status",
    "usage",
    "recordedAt",
    "recordedBy",
    "acceptanceAuthority"
  ],
  "title": "correction-cycle.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "correction-cycle.v1"
  }
}
