{
  "$id": "urn:orca:migration-control-plane:policy-decision.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "decidedBy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": ["system", "operator", "apex", "specialist", "evaluator", "adapter"],
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "decision": {
      "enum": ["allow", "deny", "exception-required"],
      "type": "string"
    },
    "effectId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^effect_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "grant": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "adapterMethod": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "adapterName": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "expiresAt": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            "maxUses": {
              "exclusiveMinimum": 0,
              "maximum": 1000,
              "type": "integer"
            },
            "networkDestinations": {
              "items": {
                "maxLength": 4096,
                "minLength": 3,
                "pattern": "^[a-z][a-z0-9+.-]*:",
                "type": "string"
              },
              "maxItems": 128,
              "type": "array"
            },
            "parameterDigest": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "secretScopes": {
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 128,
              "type": "array"
            },
            "target": {
              "additionalProperties": false,
              "properties": {
                "account": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                "project": {
                  "anyOf": [
                    {
                      "maxLength": 256,
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "provider": {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                "region": {
                  "anyOf": [
                    {
                      "maxLength": 128,
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "resourceId": {
                  "anyOf": [
                    {
                      "maxLength": 1024,
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "resourceType": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "provider",
                "account",
                "project",
                "region",
                "resourceType",
                "resourceId"
              ],
              "type": "object"
            },
            "toolNames": {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 128,
              "type": "array"
            }
          },
          "required": [
            "target",
            "adapterName",
            "adapterMethod",
            "parameterDigest",
            "toolNames",
            "networkDestinations",
            "secretScopes",
            "maxUses",
            "expiresAt"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^policy_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "intentDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "kind": {
      "const": "policy-decision",
      "type": "string"
    },
    "missionId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^mission_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "obligations": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "policyBundleDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "policyBundleVersion": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "reasons": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "ruleIds": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "structuredInputDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "missionId",
    "createdAt",
    "effectId",
    "intentDigest",
    "policyBundleVersion",
    "policyBundleDigest",
    "structuredInputDigest",
    "decision",
    "grant",
    "obligations",
    "ruleIds",
    "reasons",
    "decidedBy",
    "expiresAt"
  ],
  "title": "policy-decision.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "policy-decision.v1"
  }
}
