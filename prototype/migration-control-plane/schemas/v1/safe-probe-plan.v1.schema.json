  "$id": "urn:orca:migration-control-plane:safe-probe-plan.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blockers": {
            "items": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 64,
            "type": "array"
          },
          "cost": {
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          },
          "executable": {
            "type": "boolean"
          },
          "gapIds": {
            "items": {
              "maxLength": 128,
              "minLength": 5,
              "pattern": "^gap_[a-z0-9][a-z0-9_-]{0,111}$",
              "type": "string"
            },
            "maxItems": 1000,
            "minItems": 1,
            "type": "array"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "informationGain": {
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          },
          "limits": {
            "additionalProperties": false,
            "properties": {
              "byteLimit": {
                "exclusiveMinimum": 0,
                "maximum": 1073741824,
                "type": "integer"
              },
              "concurrencyLimit": {
                "exclusiveMinimum": 0,
                "maximum": 128,
                "type": "integer"
              },
              "queryLimit": {
                "exclusiveMinimum": 0,
                "maximum": 10000,
                "type": "integer"
              },
              "rowLimit": {
                "maximum": 10000000,
                "minimum": 0,
                "type": "integer"
              },
              "statementTimeoutMs": {
                "exclusiveMinimum": 0,
                "maximum": 600000,
                "type": "integer"
              },
              "timeLimitMs": {
                "exclusiveMinimum": 0,
                "maximum": 3600000,
                "type": "integer"
              }
            },
            "required": [
              "timeLimitMs",
              "statementTimeoutMs",
              "queryLimit",
              "rowLimit",
              "byteLimit",
              "concurrencyLimit"
            ],
            "type": "object"
          },
          "operation": {
            "enum": [
              "inventory-system",
              "inventory-schema",
              "profile-data",
              "extract-code",
              "infer-lineage",
              "inspect-cdc",
              "run-safe-probe",
              "inspect-capabilities"
            ],
            "type": "string"
          },
          "parameterDigest": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "parameters": {
            "$ref": "#/$defs/__schema0"
          },
          "predictedOutcomes": {
            "items": {
              "$ref": "#/$defs/__schema1"
            },
            "maxItems": 32,
            "minItems": 2,
            "type": "array"
          },
          "requiredScope": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "risk": {
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "gapIds",
          "operation",
          "parameters",
          "parameterDigest",
          "requiredScope",
          "limits",
          "predictedOutcomes",
          "informationGain",
          "risk",
          "cost",
          "executable",
          "blockers"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "humanException": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "gapIds": {
              "items": {
                "maxLength": 128,
                "minLength": 5,
                "pattern": "^gap_[a-z0-9][a-z0-9_-]{0,111}$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "question": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": ["gapIds", "question"],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "maxLength": 128,
      "minLength": 17,
      "pattern": "^safe_probe_plan_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "kind": {
      "const": "safe-probe-plan",
      "type": "string"
    },
    "plannedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "plannedBy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": ["system", "operator", "apex", "specialist", "evaluator", "adapter"],
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "rankingId": {
      "maxLength": 128,
      "minLength": 23,
      "pattern": "^discovery_gap_ranking_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "selectedCandidateId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "createdAt",
    "rankingId",
    "candidates",
    "selectedCandidateId",
    "humanException",
    "plannedAt",
    "plannedBy"
  ],
  "title": "safe-probe-plan.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "safe-probe-plan.v1"
