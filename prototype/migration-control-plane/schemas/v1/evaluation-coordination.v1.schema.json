              "id": {
                "maxLength": 128,
                "minLength": 11,
                "pattern": "^evaluator_[a-z0-9][a-z0-9_-]{0,111}$",
                "type": "string"
              },
              "version": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              }
            },
            "required": ["id", "version", "digest"],
            "type": "object"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "digest": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "id": {
                    "maxLength": 128,
                    "minLength": 19,
                    "pattern": "^evaluation_result_[a-z0-9][a-z0-9_-]{0,111}$",
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "passed",
                      "failed",
                      "partial",
                      "unavailable",
                      "contradictory",
                      "error",
                      "stale"
                    ],
                    "type": "string"
                  }
                },
                "required": ["id", "status", "digest"],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
