{
  "$id": "urn:orca:migration-control-plane:evaluation-coordination.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptanceAuthority": {
      "const": "none",
      "type": "string"
    },
    "acceptanceDisposition": {
      "enum": ["unaccepted", "eligible-for-reconciliation"],
      "type": "string"
    },
    "contract": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 21,
          "pattern": "^evaluation_contract_[a-z0-9][a-z0-9_-]{0,111}$",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": ["id", "version", "digest"],
      "type": "object"
    },
    "coordinationKey": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "createdBy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": ["system", "operator", "apex", "specialist", "evaluator", "adapter"],
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assignmentDigest": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "assignmentId": {
            "maxLength": 128,
            "minLength": 23,
            "pattern": "^evaluation_assignment_[a-z0-9][a-z0-9_-]{0,111}$",
            "type": "string"
          },
          "dispatchMessageId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "type": "string"
          },
          "disposition": {
            "enum": [
              "assigned",
              "missing",
              "passed",
              "failed",
              "partial",
              "unavailable",
              "contradictory",
              "error",
              "stale"
            ],
            "type": "string"
          },
          "evaluatorDefinition": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "pattern": "^[a-f0-9]{64}$",
