{
  "$id": "urn:orca:migration-control-plane:data-movement-evaluation-report.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptanceAuthority": {
      "const": "none",
      "type": "string"
    },
    "analysisDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "analysisId": {
      "maxLength": 128,
      "minLength": 21,
      "pattern": "^source_cdc_analysis_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "checks": {
      "additionalProperties": false,
      "properties": {
        "countsExact": {
          "type": "boolean"
        },
        "deletesComplete": {
          "type": "boolean"
        },
        "dispositionsComplete": {
          "type": "boolean"
        },
        "keysExact": {
          "type": "boolean"
        },
        "orderingValid": {
          "type": "boolean"
        },
        "replayExact": {
          "type": "boolean"
        },
        "watermarkExact": {
          "type": "boolean"
        }
      },
      "required": [
        "countsExact",
        "keysExact",
        "deletesComplete",
        "orderingValid",
        "watermarkExact",
        "replayExact",
        "dispositionsComplete"
      ],
      "type": "object"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "evaluatedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "evaluatedBy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": ["system", "operator", "apex", "specialist", "evaluator", "adapter"],
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "evidenceIds": {
      "items": {
        "maxLength": 128,
        "minLength": 10,
        "pattern": "^evidence_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 1,
      "type": "array"
    },
    "id": {
      "maxLength": 128,
      "minLength": 22,
      "pattern": "^data_movement_report_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "kind": {
      "const": "data-movement-evaluation-report",
      "type": "string"
    },
    "limitations": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "type": "array"
    },
    "observed": {
      "additionalProperties": false,
      "properties": {
        "appliedDeleteSequences": {
          "items": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "maxItems": 1000000,
          "type": "array"
        },
        "dispositionCount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "finalKeyDigests": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 1000000,
          "type": "array"
        },
        "finalPosition": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "finalRecordCount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "finalResumeToken": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "initialRecordCount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "invalidDispositionCount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "initialRecordCount",
        "finalRecordCount",
        "finalKeyDigests",
        "appliedDeleteSequences",
        "finalPosition",
        "finalResumeToken",
        "dispositionCount",
        "invalidDispositionCount"
      ],
      "type": "object"
    },
    "oracleDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "status": {
      "enum": ["passed", "failed"],
      "type": "string"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "traceDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "traceId": {
      "maxLength": 128,
      "minLength": 18,
      "pattern": "^source_cdc_trace_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "createdAt",
    "traceId",
    "traceDigest",
    "analysisId",
    "analysisDigest",
    "oracleDigest",
    "checks",
    "observed",
    "status",
    "evidenceIds",
    "evaluatedAt",
    "evaluatedBy",
    "limitations",
    "acceptanceAuthority"
  ],
  "title": "data-movement-evaluation-report.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "data-movement-evaluation-report.v1"
  }
}
