{
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "urn:orca:migration-control-plane:mission-event.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": ["system", "operator", "apex", "specialist", "evaluator", "adapter"],
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "aggregateRevision": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "causationCommandId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^command_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "correlationId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "eventType": {
      "enum": [
        "mission-created",
        "evidence-recorded",
        "epistemic-state-changed",
        "decision-committed",
        "plan-revision-committed",
        "task-state-changed",
        "assignment-state-changed",
        "artifact-version-recorded",
        "evaluation-state-changed",
        "correction-state-changed",
        "learning-candidate-recorded",
        "effect-state-changed",
        "mission-state-changed"
      ],
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 7,
      "pattern": "^event_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "kind": {
      "const": "mission-event",
      "type": "string"
    },
    "missionId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^mission_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/__schema0"
    },
    "payloadDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "payloadSchema": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*\\.v[1-9][0-9]*$",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": ["name", "version", "digest"],
      "type": "object"
    },
    "recordedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "missionId",
    "aggregateRevision",
    "eventType",
    "payload",
    "payloadSchema",
    "payloadDigest",
    "actor",
    "causationCommandId",
    "correlationId",
    "recordedAt"
  ],
  "title": "mission-event.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "mission-event.v1"
  }
}
