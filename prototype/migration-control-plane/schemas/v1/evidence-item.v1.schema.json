    "missionId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^mission_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "observedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "maxLength": 512,
            "type": "string"
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "type": "object"
        },
        "entity": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "environment": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "system": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
