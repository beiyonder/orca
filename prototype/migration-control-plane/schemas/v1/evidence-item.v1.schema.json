    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "version": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "missionId",
    "createdAt",
    "version",
    "sourceRole",
    "sourceName",
    "sourceVersion",
    "content",
    "scope",
    "dataClass",
    "observedAt",
    "effectiveFrom",
    "effectiveUntil",
    "supersedesEvidenceId",
    "limitations"
  ],
  "title": "evidence-item.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
