{
  "$id": "urn:orca:migration-control-plane:task-record.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "budget": {
      "additionalProperties": false,
      "properties": {
        "costLimitUsd": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "number"
        },
        "outputByteLimit": {
          "exclusiveMinimum": 0,
          "maximum": 67108864,
          "type": "integer"
        },
        "timeLimitMs": {
          "exclusiveMinimum": 0,
          "maximum": 86400000,
          "type": "integer"
        },
        "tokenLimit": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "toolCallLimit": {
          "maximum": 100000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["tokenLimit", "timeLimitMs", "toolCallLimit", "outputByteLimit", "costLimitUsd"],
      "type": "object"
    },
    "capability": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "dependencyTaskIds": {
      "items": {
        "maxLength": 128,
        "minLength": 6,
        "pattern": "^task_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array"
    },
    "id": {
      "maxLength": 128,
      "minLength": 6,
      "pattern": "^task_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "kind": {
      "const": "task",
      "type": "string"
    },
    "missionId": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^mission_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "ownedScope": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "additionalProperties": {
              "maxLength": 512,
              "type": "string"
            },
            "propertyNames": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "entity": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "environment": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "system": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["environment", "system"],
        "type": "object"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "planRevisionId": {
      "maxLength": 128,
      "minLength": 6,
      "pattern": "^plan_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "proofObligations": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "readScope": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "additionalProperties": {
              "maxLength": 512,
              "type": "string"
            },
            "propertyNames": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "entity": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "environment": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "system": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["environment", "system"],
        "type": "object"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "recoveryPolicy": {
      "additionalProperties": false,
      "properties": {
        "maxAttempts": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "type": "integer"
        },
        "onStaleResult": {
          "const": "reject-authority-retain-evidence",
          "type": "string"
        },
        "onWorkerLoss": {
          "enum": ["retry", "reconstruct", "quarantine", "fail"],
          "type": "string"
        },
        "requiresEvaluation": {
          "type": "boolean"
        }
      },
      "required": ["onWorkerLoss", "onStaleResult", "maxAttempts", "requiresEvaluation"],
      "type": "object"
    },
    "requiredEvaluationContractIds": {
      "items": {
        "maxLength": 128,
        "minLength": 21,
        "pattern": "^evaluation_contract_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 0,
      "type": "array"
    },
    "revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "state": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": ["pending", "runnable"],
              "type": "string"
            }
          },
          "required": ["status"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attemptId": {
              "maxLength": 128,
              "minLength": 9,
              "pattern": "^attempt_[a-z0-9][a-z0-9_-]{0,111}$",
              "type": "string"
            },
            "fence": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "leaseExpiresAt": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            "status": {
              "enum": ["leased", "running"],
              "type": "string"
            }
          },
          "required": ["status", "attemptId", "fence", "leaseExpiresAt"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attemptId": {
              "maxLength": 128,
              "minLength": 9,
              "pattern": "^attempt_[a-z0-9][a-z0-9_-]{0,111}$",
              "type": "string"
            },
            "evaluationAssignmentIds": {
              "items": {
                "maxLength": 128,
                "minLength": 23,
                "pattern": "^evaluation_assignment_[a-z0-9][a-z0-9_-]{0,111}$",
                "type": "string"
              },
              "maxItems": 128,
              "minItems": 1,
              "type": "array"
            },
            "fence": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "status": {
              "const": "evaluating",
              "type": "string"
            }
          },
          "required": ["status", "attemptId", "fence", "evaluationAssignmentIds"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "gapIds": {
              "items": {
                "maxLength": 128,
                "minLength": 5,
                "pattern": "^gap_[a-z0-9][a-z0-9_-]{0,111}$",
                "type": "string"
              },
              "maxItems": 1000,
              "minItems": 1,
              "type": "array"
            },
            "status": {
              "const": "blocked",
              "type": "string"
            }
          },
          "required": ["status", "gapIds"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "quarantinedAt": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            "reason": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "status": {
              "const": "quarantined",
              "type": "string"
            }
          },
          "required": ["status", "reason", "quarantinedAt"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "acceptedArtifactVersionIds": {
              "items": {
                "maxLength": 128,
                "minLength": 18,
                "pattern": "^artifact_version_[a-z0-9][a-z0-9_-]{0,111}$",
                "type": "string"
              },
              "maxItems": 1000,
              "minItems": 0,
              "type": "array"
            },
            "acceptedAssignmentResultIds": {
              "items": {
                "maxLength": 128,
                "minLength": 19,
                "pattern": "^assignment_result_[a-z0-9][a-z0-9_-]{0,111}$",
                "type": "string"
              },
              "maxItems": 1000,
              "minItems": 0,
              "type": "array"
            },
            "completedAt": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            "reason": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "status": {
              "enum": ["completed", "failed", "cancelled"],
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason",
            "completedAt",
            "acceptedAssignmentResultIds",
            "acceptedArtifactVersionIds"
          ],
          "type": "object"
        }
      ]
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "title": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "missionId",
    "createdAt",
    "revision",
    "planRevisionId",
    "title",
    "capability",
    "dependencyTaskIds",
    "proofObligations",
    "requiredEvaluationContractIds",
    "ownedScope",
    "readScope",
    "budget",
    "recoveryPolicy",
    "state"
  ],
  "title": "task-record.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "task-record.v1"
  }
}
