{
  "$id": "urn:orca:migration-control-plane:memory-invalidation.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "disposition": {
      "enum": ["stale", "deprecated", "revoked", "forgotten"],
      "type": "string"
    },
    "evidenceIds": {
      "items": {
        "maxLength": 128,
        "minLength": 10,
        "pattern": "^evidence_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "id": {
      "maxLength": 128,
      "minLength": 21,
      "pattern": "^memory_invalidation_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "impactReviewIds": {
      "items": {
        "maxLength": 128,
        "minLength": 8,
        "pattern": "^impact_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 0,
      "type": "array"
    },
    "impactedUseIds": {
      "items": {
        "maxLength": 128,
        "minLength": 12,
        "pattern": "^memory_use_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 0,
      "type": "array"
    },
    "invalidatedBy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": ["system", "operator", "apex", "specialist", "evaluator", "adapter"],
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "kind": {
      "const": "memory-invalidation",
      "type": "string"
    },
    "memoryVersionId": {
      "maxLength": 128,
      "minLength": 16,
      "pattern": "^memory_version_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "reason": {
      "enum": [
        "source-invalidated",
        "stale",
        "conflict",
        "poison",
        "scope-error",
        "legal-delete",
        "evaluator-regression",
        "replaced"
      ],
      "type": "string"
    },
    "reasonDetail": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "replacementVersionId": {
      "maxLength": 128,
      "minLength": 16,
      "pattern": "^memory_version_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "createdAt",
    "memoryVersionId",
    "reason",
    "evidenceIds",
    "replacementVersionId",
    "impactedUseIds",
    "impactReviewIds",
    "disposition",
    "reasonDetail",
    "invalidatedBy"
  ],
  "title": "memory-invalidation.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "memory-invalidation.v1"
  }
}
