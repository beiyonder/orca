{
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "urn:orca:migration-control-plane:capability-manifest.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "mediaType": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[a-z0-9!#$&^_.+-]+\\/[a-z0-9!#$&^_.+-]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "span": {
          "default": {
            "kind": "whole"
          },
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "whole",
                  "type": "string"
                }
              },
              "required": ["kind"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "endLine": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "kind": {
                  "const": "text-lines",
                  "type": "string"
                },
                "startLine": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                }
              },
              "required": ["kind", "startLine", "endLine"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "json-pointer",
                  "type": "string"
                },
                "pointer": {
                  "maxLength": 4096,
                  "pattern": "^(?:\\/[^/]*)*$",
                  "type": "string"
                }
              },
              "required": ["kind", "pointer"],
              "type": "object"
            }
          ]
        },
        "uri": {
          "maxLength": 4096,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9+.-]*:",
          "type": "string"
        }
      },
      "required": ["uri", "sha256", "mediaType", "bytes", "span"],
      "type": "object"
    },
    "authorityEnvelope": {
      "$ref": "#/$defs/__schema0"
    },
    "capabilityType": {
      "enum": ["context-policy", "prompt-program", "skill", "tool", "model-route", "evaluator"],
      "type": "string"
    },
    "compatibleModelRoutes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "dataClasses": {
            "items": {
              "enum": ["synthetic", "public", "internal", "confidential", "restricted", "phi"],
              "type": "string"
            },
            "maxItems": 6,
            "minItems": 1,
            "type": "array"
          },
          "effort": {
            "enum": ["lo", "med", "hi"],
            "type": "string"
          },
          "model": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "provider": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "revision": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["provider", "model", "revision", "effort", "dataClasses"],
        "type": "object"
      },
      "maxItems": 64,
      "type": "array"
    },
    "contract": {
      "additionalProperties": false,
      "properties": {
        "inputSchemaId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "outputSchemaId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "schemaDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": ["inputSchemaId", "outputSchemaId", "schemaDigest"],
      "type": "object"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "dataClasses": {
      "items": {
        "enum": ["synthetic", "public", "internal", "confidential", "restricted", "phi"],
        "type": "string"
      },
      "maxItems": 6,
      "minItems": 1,
      "type": "array"
    },
    "evaluationContractIds": {
      "items": {
        "maxLength": 128,
        "minLength": 21,
        "pattern": "^evaluation_contract_[a-z0-9][a-z0-9_-]{0,111}$",
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "id": {
      "maxLength": 128,
      "minLength": 12,
      "pattern": "^capability_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "kind": {
      "const": "capability-manifest",
      "type": "string"
    },
    "license": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "predecessorCapabilityId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 12,
          "pattern": "^capability_[a-z0-9][a-z0-9_-]{0,111}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "requiredTools": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "approval": {
            "enum": ["read", "write", "exec"],
            "type": "string"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "schemaDigest": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "version": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["name", "version", "schemaDigest", "approval"],
        "type": "object"
      },
      "maxItems": 128,
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "signer": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "quarantined",
              "type": "string"
            }
          },
          "required": ["status"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "certificationId": {
              "maxLength": 128,
              "minLength": 15,
              "pattern": "^certification_[a-z0-9][a-z0-9_-]{0,111}$",
              "type": "string"
            },
            "status": {
              "const": "certified",
              "type": "string"
            }
          },
          "required": ["status", "certificationId"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "activatedAt": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            "certificationId": {
              "maxLength": 128,
              "minLength": 15,
              "pattern": "^certification_[a-z0-9][a-z0-9_-]{0,111}$",
              "type": "string"
            },
            "promotionId": {
              "maxLength": 128,
              "minLength": 11,
              "pattern": "^promotion_[a-z0-9][a-z0-9_-]{0,111}$",
              "type": "string"
            },
            "status": {
              "const": "active",
              "type": "string"
            }
          },
          "required": ["status", "certificationId", "promotionId", "activatedAt"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "certificationId": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "minLength": 15,
                  "pattern": "^certification_[a-z0-9][a-z0-9_-]{0,111}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "settledAt": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
            },
            "status": {
              "enum": ["demoted", "revoked"],
              "type": "string"
            }
          },
          "required": ["status", "certificationId", "reason", "settledAt"],
          "type": "object"
        }
      ]
    },
    "tenantId": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^tenant_[a-z0-9][a-z0-9_-]{0,111}$",
      "type": "string"
    },
    "version": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "tenantId",
    "createdAt",
    "version",
    "capabilityType",
    "artifact",
    "contract",
    "compatibleModelRoutes",
    "requiredTools",
    "dataClasses",
    "authorityEnvelope",
    "evaluationContractIds",
    "predecessorCapabilityId",
    "license",
    "signer",
    "status"
  ],
  "title": "capability-manifest.v1",
  "type": "object",
  "x-orca-contract": {
    "registryVersion": 1,
    "runtimeInvariantValidationRequired": true,
    "schemaName": "capability-manifest.v1"
  }
}
